# Copy to .env and adjust. Never commit real secrets.
MIND_ENV=dev
MIND_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/mind
MIND_REDIS_URL=redis://localhost:6379/0
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
MIND_SECRET_KEY=change-me-to-a-long-random-string
# Generate: .venv/bin/mind-api gen-key   (required when MIND_ENV=prod)
MIND_ENCRYPTION_KEY=
MIND_CORS_ORIGINS=["http://localhost:3000"]
MIND_PUBLIC_API_URL=http://localhost:8000
MIND_PREVIEW_PUBLIC_URL=http://localhost:8100
MIND_COOKIE_SECURE=false
MIND_ALLOW_REGISTRATION=true
MIND_STORAGE_BACKEND=local
MIND_STORAGE_DIR=data/storage
# S3-compatible storage (MinIO, AWS S3, Cloudflare R2, ...)
# MIND_STORAGE_BACKEND=s3
# MIND_S3_BUCKET=mind
# MIND_S3_ENDPOINT_URL=http://localhost:9000
# MIND_S3_ACCESS_KEY_ID=
# MIND_S3_SECRET_ACCESS_KEY=
MIND_SANDBOX_ENABLED=true
MIND_MAX_UPLOAD_MB=50
# AI provider keys are NOT read from the environment: add them in Settings → AI providers,
# where they are validated and stored encrypted per organization.
